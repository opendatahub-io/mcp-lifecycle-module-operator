# -----------------------------------------------------------------------------
# Builder stage
# -----------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/go-toolset@sha256:6f246e8913d082df463b62a74c72f0d2b410583e1b2ac48add39cd7ede59ce62 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# Copy source code
COPY . .

USER root

# Enable strict FIPS runtime support during build
ENV GOEXPERIMENT=strictfipsruntime
# Build the manager binary
RUN make build GO_BUILD_ENV="GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH}"

# -----------------------------------------------------------------------------
# Crypto policy stage (throwaway – python3 stays out of the final image)
# -----------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:5ed244b62bbf4095080144d9d35eb8fcd3d39a9801f94aadd63b9d10978a01ae AS crypto-policy

RUN microdnf install -y crypto-policies-scripts && \
    update-crypto-policies --set DEFAULT:PQ --no-reload

# -----------------------------------------------------------------------------
# Runtime stage
# -----------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:5ed244b62bbf4095080144d9d35eb8fcd3d39a9801f94aadd63b9d10978a01ae

COPY --from=crypto-policy /etc/crypto-policies /etc/crypto-policies

WORKDIR /

# Copy the controller binary
COPY --from=builder /workspace/bin/manager .

# Copy license files
RUN mkdir /licenses
COPY --from=builder /workspace/LICENSE /licenses/

# Run as non-root
USER 65532:65532

# -----------------------------------------------------------------------------
# Labels for enterprise contract
# -----------------------------------------------------------------------------
LABEL com.redhat.component=mcp-lifecycle-module-operator
LABEL cpe="cpe:/a:redhat:mcp_lifecycle_operator:0.1::el9"
LABEL description="MCP lifecycle module operator"
LABEL io.k8s.description="MCP lifecycle module operator"
LABEL io.k8s.display-name="MCP lifecycle module operator"
LABEL io.openshift.tags="openshift,mcp,operator"
LABEL name="mcp-lifecycle-operator-beta/mcp-lifecycle-module-rhel9-operator"
LABEL release=0.1.0
LABEL url="https://github.com/opendatahub-io/mcp-lifecycle-module-operator"
LABEL vendor="Red Hat, Inc."
LABEL version=0.1.0
LABEL summary="MCP lifecycle module operator"

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
ENTRYPOINT ["/manager"]
